# Progressive W&B configuration for multi-length training
def setup_wandb_run(run_number: int, conversation_type: str, config: dict):
    """
    Set up W&B run with proper entity, project, and configuration.
    
    Args:
        run_number: 1, 2, or 3 for progressive runs
        conversation_type: "short", "medium", or "long"
        config: Training configuration dictionary
    """
    
    # Determine run-specific settings
    run_name = f"therapy-bot-run{run_number}-{conversation_type}"
    
    run_notes = f"""
    Progressive Training Run {run_number} ({conversation_type.title()} Exchanges)
    
    Training Details:
    - Exchange length: {config.get('exchange_length', 'N/A')}
    - Dataset size: {config.get('dataset_size', 'N/A')}
    - LoRA rank: {config.get('lora_rank', 'N/A')}
    - Learning rate: {config.get('learning_rate', 'N/A')}
    - Batch size: {config.get('batch_size', 'N/A')}
    
    Expected Duration: {config.get('expected_duration', 'N/A')}
    """
    
    run_tags = [
        f"run{run_number}",
        conversation_type,
        "therapy",
        "dbt",
        "llama-3.1-8b",
        "lora",
        "progressive-training",
        config.get('model_name', 'llama-3.1-8b')
    ]
    
    # Initialize W&B run with comprehensive configuration
    wandb.init(
        # Workspace configuration
        entity="natanelrichey_therabot",  # Your W&B username/team
        project="TheraBot",                # Project name
        
        # Run identification
        name=run_name,
        notes=run_notes,
        tags=run_tags,
        
        # Configuration tracking
        config=config,
        
        # Reproducibility
        save_code=True,                    # Save training code
        job_type="fine-tuning",           # Job classification
        
        # Resume configuration (for interrupted runs)
        resume="allow",                    # Can resume interrupted runs
        id=f"run{run_number}-{conversation_type}",  # Unique run ID
        
        # Mode (online for live tracking, offline for local)
        mode="online",                     # Use "offline" if no internet
        
        # Metadata
        group="progressive-multi-length",  # Group related runs
        reinit=True                        # Allow re-initialization
    )
    
    return wandb.run


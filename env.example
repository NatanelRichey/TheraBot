# TheraBot Environment Variables Template
# Copy this file to .env or env.development and fill in your actual values

# =============================================================================
# WEIGHTS & BIASES (W&B) CONFIGURATION
# =============================================================================
# Get your API key from: https://wandb.ai/settings
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=TheraBot
WANDB_ENTITY=your_wandb_username
WANDB_MODE=online  # or 'offline' for local development

# =============================================================================
# HUGGINGFACE HUB CONFIGURATION
# =============================================================================
# Get your token from: https://huggingface.co/settings/tokens
# Make sure it has "write" permissions
HF_TOKEN=your_huggingface_token_here
HF_USERNAME=your_huggingface_username
HF_MODEL_REPO=therabot-llama-3.1-8b-therapy-lora
HF_MODEL_PRIVATE=true

# =============================================================================
# GOOGLE DRIVE CONFIGURATION (Optional)
# =============================================================================
# For checkpoint backup - only needed if using Google Drive backup
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CREDENTIALS_PATH=path/to/credentials.json
GOOGLE_DRIVE_BACKUP_FOLDER_ID=your_drive_folder_id

# =============================================================================
# TRAINING CONFIGURATION
# =============================================================================
# Model and training settings
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
OUTPUT_DIR=./therapy-model-checkpoints
LOG_DIR=./logs

# Memory optimization settings
PER_DEVICE_TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=8
LORA_RANK=8
LOAD_IN_4BIT=true
GRADIENT_CHECKPOINTING=true

# Learning configuration
LEARNING_RATE=2e-4
NUM_TRAIN_EPOCHS=3
WARMUP_STEPS=200
WEIGHT_DECAY=0.01
MAX_GRAD_NORM=1.0

# =============================================================================
# DATA CONFIGURATION
# =============================================================================
# Dataset paths
DATASET_RUN1_PATH=data/processed_run1_short_processed/therapy_dataset
DATASET_RUN2_PATH=data/processed_run2_medium_processed/therapy_dataset
DATASET_RUN3_PATH=data/processed_run3_long_processed/therapy_dataset

# Data splits
TRAIN_SPLIT=0.8
VAL_SPLIT=0.1
TEST_SPLIT=0.1

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
# Logging configuration
LOG_LEVEL=INFO
REPORT_TO=wandb,tensorboard
LOG_STEPS=10
SAVE_STEPS=500
EVAL_STEPS=100

# =============================================================================
# SAFETY AND PRIVACY
# =============================================================================
# Privacy settings
ENCRYPT_CHECKPOINTS=true
DELETE_CLOUD_AFTER_DOWNLOAD=false
ANONYMIZE_DATA=true

# Crisis detection keywords (comma-separated)
CRISIS_KEYWORDS=suicide,self-harm,kill myself,hurt myself,end it all

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development mode settings
DEBUG=false
VERBOSE_LOGGING=false
SKIP_VALIDATION=false
DRY_RUN=false

# =============================================================================
# COLAB SPECIFIC SETTINGS
# =============================================================================
# Google Colab specific configurations
COLAB_MODE=true
MOUNT_DRIVE=true
RESTART_RUNTIME_AFTER_INSTALL=true
